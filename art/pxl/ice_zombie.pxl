// head 0,0
place head_top 8 0
place head_bottom 16 0
place head_side 0 8
place head_front 8 8
place head_side 16 8 flipx
place head_back 24 8
// body 16,16
place body_top 20 16
place body_bottom 28 16
place body_side 16 20
place body_front 20 20
place body_side 28 20 flipx
place body_back 32 20
// right arm 40,16
place arm_top 44 16
place arm_bottom 48 16
place arm_side 40 20
place arm_front 44 20
place arm_side 48 20 flipx
place arm_back 52 20
// right leg 0,16
place leg_top 4 16
place leg_bottom 8 16
place leg_side 0 20
place leg_front 4 20
place leg_side 8 20 flipx
place leg_back 12 20
// left arm 32,48
place arm_top 36 48
place arm_bottom 40 48
place arm_side 32 52 flipx
place arm_front 36 52
place arm_side 40 52
place arm_back 44 52
// left leg 16,48
place leg_top 20 48
